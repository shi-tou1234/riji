---
import '@styles/theme.css';
import '@styles/markdown.css';
import { ClientRouter } from 'astro:transitions';
import Header from '@components/Header.astro';
import siteInfo from '@/config';
import { withBase } from '@utils/urls';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteInfo.slogan } = Astro.props;
const pageTitle = title ? `${title} · ${siteInfo.title}` : siteInfo.title;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <meta name="theme-color" content="#f5f0e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1712" media="(prefers-color-scheme: dark)" />
    <ClientRouter />
    {/* 主题和 js 标记必须在首屏绘制前定好；View Transitions 换页会替换 <html> 的属性，
        所以astro:after-swap 时要再补一遍，否则换页后主题丢失、滚动入场元素永远隐藏 */}
    <script is:inline>
      (function () {
        var apply = function () {
          try {
            var saved = localStorage.getItem('theme');
            var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.dataset.theme = saved || (dark ? 'dark' : 'light');
          } catch (e) {
            document.documentElement.dataset.theme = 'light';
          }
          document.documentElement.classList.add('js');
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>
  <body>
    <div class="progress" id="progress" aria-hidden="true"></div>
    <Header />
    <main>
      <slot />
    </main>
    <footer class="footer">
      <span class="footer__mark" aria-hidden="true"></span>
      <p>{siteInfo.title} · 由 {siteInfo.author} 与他的 agent 们共同书写</p>
    </footer>

    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* 滚动入场：带 data-reveal 的元素进入视口时落位。
           首屏批次沿用各自的 --d 做编排，之后滚到的立即出现，不再傻等延迟 */
        function setupReveals() {
          var els = document.querySelectorAll('[data-reveal]:not(.in)');
          if (!els.length) return;
          if (reduce || !('IntersectionObserver' in window)) {
            els.forEach(function (el) {
              el.classList.add('in');
            });
            return;
          }
          var t0 = performance.now();
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (en) {
                if (!en.isIntersecting) return;
                if (performance.now() - t0 > 900) en.target.style.setProperty('--d', '0ms');
                en.target.classList.add('in');
                io.unobserve(en.target);
              });
            },
            { threshold: 0.1, rootMargin: '0px 0px -6% 0px' }
          );
          els.forEach(function (el) {
            if (!el.__rev) {
              el.__rev = 1;
              io.observe(el);
            }
          });
        }

        /* 首页统计数字滚动：SSR 直出终值，无 JS 时数字原样 */
        function countUp() {
          document.querySelectorAll('[data-count]').forEach(function (el) {
            if (el.__counted) return;
            el.__counted = 1;
            var target = parseInt(el.dataset.count, 10);
            if (isNaN(target) || reduce || target <= 0) return;
            var t0 = null;
            function step(t) {
              if (!t0) t0 = t;
              var p = Math.min(1, (t - t0) / 900);
              el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
              if (p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
          });
        }

        /* 文章页：阅读进度条 */
        function setupProgress() {
          var bar = document.getElementById('progress');
          if (!bar) return;
          if (!document.querySelector('.post')) {
            bar.hidden = true;
            return;
          }
          bar.hidden = false;
          var ticking = false;
          var update = function () {
            ticking = false;
            var h = document.documentElement;
            var max = h.scrollHeight - h.clientHeight;
            bar.style.transform = 'scaleX(' + (max > 0 ? h.scrollTop / max : 0) + ')';
          };
          if (!bar.__wired) {
            bar.__wired = 1;
            window.addEventListener(
              'scroll',
              function () {
                if (!ticking) {
                  ticking = true;
                  requestAnimationFrame(update);
                }
              },
              { passive: true }
            );
            window.addEventListener('resize', update, { passive: true });
          }
          update();
        }

        /* 文章页：目录跟随高亮 */
        function setupSpy() {
          var links = document.querySelectorAll('.toc__link');
          if (!links.length) return;
          var heads = [];
          links.forEach(function (l) {
            var id = decodeURIComponent((l.getAttribute('href') || '').slice(1));
            var h = id && document.getElementById(id);
            if (h) heads.push({ h: h, l: l });
          });
          if (!heads.length || !('IntersectionObserver' in window)) return;
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (en) {
                if (!en.isIntersecting) return;
                links.forEach(function (l) {
                  l.classList.toggle('is-active', l === en.target.__link);
                });
              });
            },
            { rootMargin: '-12% 0px -72% 0px', threshold: 0 }
          );
          heads.forEach(function (it) {
            it.h.__link = it.l;
            io.observe(it.h);
          });
        }

        /* 代码块复制按钮 */
        function setupCopy() {
          if (!navigator.clipboard) return;
          document.querySelectorAll('.post-content pre.astro-code').forEach(function (pre) {
            if (pre.closest('.code-wrap')) return;
            var wrap = document.createElement('div');
            wrap.className = 'code-wrap';
            pre.parentNode.insertBefore(wrap, pre);
            wrap.appendChild(pre);
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'copy-btn';
            btn.textContent = '复制';
            btn.addEventListener('click', function () {
              navigator.clipboard.writeText(pre.innerText).then(function () {
                btn.textContent = '已复制';
                btn.classList.add('is-copied');
                setTimeout(function () {
                  btn.textContent = '复制';
                  btn.classList.remove('is-copied');
                }, 1600);
              });
            });
            wrap.appendChild(btn);
          });
        }

        /* 首页月份导航：手机是横向吸顶选项卡，桌面 ≥901px 是左侧竖排卷目。
           切换带滑动指示线，#m-… 直达某月，#e-… 落回某一篇 */
        function setupTabs() {
          var nav = document.querySelector('.months');
          if (!nav || nav.__wired) return;
          nav.__wired = 1;
          var row = nav.querySelector('.months__row');
          var tabs = [].slice.call(nav.querySelectorAll('.months__tab'));
          var ind = nav.querySelector('.months__indicator');
          var sections = [].slice.call(document.querySelectorAll('.month'));
          var mq = window.matchMedia('(min-width: 901px)');
          if (!tabs.length) return;

          var move = function (t) {
            if (!ind) return;
            row.setAttribute('aria-orientation', mq.matches ? 'vertical' : 'horizontal');
            if (mq.matches) {
              ind.style.width = '2px';
              ind.style.height = t.offsetHeight + 'px';
              ind.style.transform = 'translateY(' + t.offsetTop + 'px)';
            } else {
              ind.style.height = '2px';
              ind.style.width = t.offsetWidth + 'px';
              ind.style.transform = 'translateX(' + t.offsetLeft + 'px)';
            }
          };

          /* 落到某一篇：先把它的入场动画钉住再量位置，滚到位后纸面闪一道朱砂 */
          var landOnCard = function (card) {
            var header = document.querySelector('.header');
            var hh = header ? header.offsetHeight : 0;
            card.style.transition = 'none';
            card.style.setProperty('--d', '0ms');
            card.classList.add('in');
            void card.offsetWidth;
            card.style.transition = '';
            var y = card.getBoundingClientRect().top + window.scrollY - hh - 20;
            window.scrollTo({ top: Math.max(0, y), behavior: reduce ? 'auto' : 'smooth' });
            card.classList.remove('is-landed');
            void card.offsetWidth;
            card.classList.add('is-landed');
          };

          var select = function (t, scroll) {
            tabs.forEach(function (x) {
              var on = x === t;
              x.classList.toggle('is-active', on);
              x.setAttribute('aria-selected', on ? 'true' : 'false');
              x.tabIndex = on ? 0 : -1;
            });
            var id = t.getAttribute('aria-controls');
            sections.forEach(function (s) {
              var on = s.id === id;
              if (on && s.hidden) {
                s.hidden = false;
                /* 切换时整块轻抬一次 */
                s.classList.remove('is-entering');
                void s.offsetWidth;
                s.classList.add('is-entering');
                var h = s.querySelector('.index__month');
                if (h) h.style.setProperty('--d', '0ms');
              } else if (!on) {
                s.hidden = true;
              }
            });
            move(t);
            t.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'auto' });
            if (scroll) {
              var header = document.querySelector('.header');
              var hh = header ? header.offsetHeight : 0;
              if (mq.matches) {
                /* 桌面侧栏常驻：把列表顶部带到顶栏正下方 */
                var list = document.querySelector('.index__list');
                if (list) {
                  var lr = list.getBoundingClientRect();
                  if (lr.top > hh + 2 || lr.top < -40) {
                    window.scrollTo({
                      top: window.scrollY + lr.top - hh - 10,
                      behavior: reduce ? 'auto' : 'smooth',
                    });
                  }
                }
              } else {
                var r = nav.getBoundingClientRect();
                /* 还没滚到导航条时，切完把它带到顶栏正下方；已经吸住了就不动 */
                if (r.top > hh + 2) {
                  window.scrollTo({
                    top: window.scrollY + r.top - hh - 1,
                    behavior: reduce ? 'auto' : 'smooth',
                  });
                }
              }
            }
          };

          tabs.forEach(function (t) {
            t.addEventListener('click', function (e) {
              e.preventDefault();
              select(t, true);
              history.replaceState(null, '', '#' + t.getAttribute('aria-controls'));
            });
            t.addEventListener('keydown', function (e) {
              var i = tabs.indexOf(t);
              var n = null;
              if (e.key === 'ArrowRight') n = tabs[(i + 1) % tabs.length];
              else if (e.key === 'ArrowLeft') n = tabs[(i - 1 + tabs.length) % tabs.length];
              else if (e.key === 'ArrowDown') n = tabs[(i + 1) % tabs.length];
              else if (e.key === 'ArrowUp') n = tabs[(i - 1 + tabs.length) % tabs.length];
              else if (e.key === 'Home') n = tabs[0];
              else if (e.key === 'End') n = tabs[tabs.length - 1];
              if (n) {
                e.preventDefault();
                n.focus();
                select(n, true);
              }
            });
          });

          /* 带 hash 进来：#m-… 直达对应月份；#e-… 落回某一篇并点亮它所在的月份 */
          var target = null;
          var h = decodeURIComponent(location.hash || '');
          tabs.forEach(function (t) {
            if (h === '#' + t.getAttribute('aria-controls')) target = t;
          });
          var card = null;
          if (!target && h.slice(1, 3) === 'e-') {
            card = document.getElementById(h.slice(1));
            if (card) {
              var sec = card.closest('.month');
              var tab = sec ? nav.querySelector('[aria-controls="' + sec.id + '"]') : null;
              if (tab) target = tab;
              else card = null;
            }
          }
          select(target || tabs[0], false);
          if (card) landOnCard(card);

          window.addEventListener(
            'resize',
            function () {
              move(nav.querySelector('.months__tab.is-active'));
            },
            { passive: true }
          );
          if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(function () {
              var active = nav.querySelector('.months__tab.is-active');
              if (active) move(active);
            });
          }
        }

        function initAll() {
          setupReveals();
          countUp();
          setupProgress();
          setupSpy();
          setupCopy();
          setupTabs();
        }

        /* ClientRouter 存在时 astro:page-load 首次加载也会触发 */
        document.addEventListener('astro:page-load', initAll);
        initAll();
      })();
    </script>
  </body>
</html>
