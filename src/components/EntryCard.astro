---
import type { CollectionEntry } from 'astro:content';
import { hueOf, readingTime } from '@utils/format';
import { withBase } from '@utils/urls';

interface Props {
  entry: CollectionEntry<'diary'>;
  summary: string;
  /** 锚点 id：文章页「回到时间线」靠它落回原来那一篇 */
  id?: string;
  /** 入场动画的延迟（毫秒），按目录顺序递增 */
  delay?: number;
}

const { entry, summary, id, delay = 0 } = Astro.props;
const date = entry.data.date;
const minutes = readingTime(entry.body ?? '');
const WEEKDAYS = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
const pad = (n: number) => String(n).padStart(2, '0');
---

<article class="entry" id={id} data-reveal style={`--d: ${delay}ms`}>
  <a class="entry__link" href={withBase(`d/${entry.id}/`)}>
    <div class="entry__when">
      <span class="entry__day">{pad(date.getDate())}</span>
      <span class="entry__week">{WEEKDAYS[date.getDay()]}</span>
    </div>
    <div class="entry__body">
      <h2 class="entry__title">{entry.data.title}</h2>
      {summary && <p class="entry__summary">{summary}</p>}
      <p class="entry__meta">
        {
          entry.data.projects.length > 0 && (
            <span class="proj-chips">
              {entry.data.projects.map((p) => (
                <span class="proj-chip" style={`--hue: ${hueOf(p)}`}>
                  {p}
                </span>
              ))}
            </span>
          )
        }
        <span>约 {minutes} 分钟</span>
        <span class="entry__arrow" aria-hidden="true">→</span>
      </p>
    </div>
  </a>
</article>
