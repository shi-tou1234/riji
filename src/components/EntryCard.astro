---
import type { CollectionEntry } from 'astro:content';
import { readingTime } from '@utils/format';
import { withBase } from '@utils/urls';

interface Props {
  entry: CollectionEntry<'diary'>;
  summary: string;
}

const { entry, summary } = Astro.props;
const date = entry.data.date;
const minutes = readingTime(entry.body ?? '');
const WEEKDAYS = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
const pad = (n: number) => String(n).padStart(2, '0');
---

<article class="tl-item">
  <a class="tl-card" href={withBase(`d/${entry.id}/`)}>
    <p class="tl-card__date">
      <span class="tl-card__day">{pad(date.getDate())}</span>
      <span>{date.getFullYear()} · {pad(date.getMonth() + 1)}</span>
      <span class="tl-card__week">{WEEKDAYS[date.getDay()]}</span>
    </p>
    <h2 class="tl-card__title">{entry.data.title}</h2>
    {summary && <p class="tl-card__summary">{summary}</p>}
    <p class="tl-card__foot">
      <span>约 {minutes} 分钟</span>
      <span class="tl-card__arrow" aria-hidden="true">→</span>
    </p>
  </a>
</article>
