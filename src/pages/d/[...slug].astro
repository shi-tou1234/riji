---
import { getCollection, render } from 'astro:content';
import Base from '@layouts/Base.astro';
import Toc from '@components/Toc.astro';
import { formatDateCN, hueOf, readingTime, excerpt, cnMonthLabel } from '@utils/format';
import { withBase } from '@utils/urls';

export async function getStaticPaths() {
  const entries = (await getCollection('diary', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
  );
  const latestYear = entries.at(-1)?.data.date.getFullYear() ?? 0;
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      older: entries[i - 1] ?? null,
      newer: entries[i + 1] ?? null,
      latestYear,
    },
  }));
}

const { entry, older, newer, latestYear } = Astro.props;
const { Content, headings } = await render(entry);
const minutes = readingTime(entry.body ?? '');

/** 返回链接要写明落点：九月 / 2025年三月 */
const backLabel = cnMonthLabel(
  entry.data.date.getFullYear(),
  entry.data.date.getMonth() + 1,
  latestYear,
);
---

<Base title={entry.data.title} description={entry.data.summary || excerpt(entry.body ?? '', 60)}>
  <div class="post">
    <article class="post__main" data-reveal>
      <a class="back" href={withBase(`#e-${entry.id}`)}>← 回到{backLabel}</a>
      <h1 class="post__title">{entry.data.title}</h1>
      <p class="post__meta">
        <time datetime={entry.data.date.toISOString()}>{formatDateCN(entry.data.date)}</time>
        <span>约 {minutes} 分钟</span>
        {
          entry.data.projects.length > 0 && (
            <span class="proj-chips">
              {entry.data.projects.map((p) => (
                <span class="proj-chip" style={`--hue: ${hueOf(p)}`}>
                  {p}
                </span>
              ))}
            </span>
          )
        }
        {
          entry.data.models.length > 0 && (
            <span class="model-chips">
              {entry.data.models.map((m) => (
                <span class="model-chip">{m}</span>
              ))}
            </span>
          )
        }
      </p>
      <div class="post-content">
        <Content />
      </div>

      {
        (older || newer) && (
          <nav class="post__pn" aria-label="翻到上一篇或下一篇">
            {older ? (
              <a class="pn" href={withBase(`d/${older.id}/`)}>
                <span class="pn__dir">← 上一篇</span>
                <span class="pn__title">{older.data.title}</span>
                <span class="pn__date">{formatDateCN(older.data.date)}</span>
              </a>
            ) : (
              <span class="pn pn--none" aria-hidden="true" />
            )}
            {newer ? (
              <a class="pn pn--next" href={withBase(`d/${newer.id}/`)}>
                <span class="pn__dir">下一篇 →</span>
                <span class="pn__title">{newer.data.title}</span>
                <span class="pn__date">{formatDateCN(newer.data.date)}</span>
              </a>
            ) : (
              <span class="pn pn--none" aria-hidden="true" />
            )}
          </nav>
        )
      }
    </article>
    <Toc headings={headings} />
  </div>
</Base>
