---
import { getEntry, render } from 'astro:content';
import Base from '@layouts/Base.astro';
import { withBase } from '@utils/urls';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('缺少 src/content/pages/about.md');

const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description}>
  <!-- 卷首语：单栏居中，不吃日记页的目录栏和批注规矩 -->
  <div class="post post--solo">
    <article class="post__main" data-reveal>
      <a class="back" href={withBase('')}>← 回到时间线</a>
      <p class="post__kicker" aria-hidden="true">卷首语</p>
      <h1 class="post__title">{page.data.title}</h1>
      <div class="post-content">
        <Content />
      </div>
    </article>
  </div>
</Base>
