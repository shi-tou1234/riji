---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import EntryCard from '@components/EntryCard.astro';
import siteInfo from '@/config';
import { excerpt, cnNum, cnMonth, cnMonthLabel } from '@utils/format';
import { withBase } from '@utils/urls';

const entries = (await getCollection('diary', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const pad = (n: number) => String(n).padStart(2, '0');
const ym = (d: Date) => `${d.getFullYear()}.${pad(d.getMonth() + 1)}`;

/** 起于：最早那篇的日期；一篇都没有就退回建站日期 */
const startDate = entries.at(-1)?.data.date ?? new Date(siteInfo.createdAt);

/** 累计字数（不含空白），够多就折成 k */
const totalChars = entries.reduce((sum, e) => sum + (e.body ?? '').replace(/\s/g, '').length, 0);
const charText = totalChars >= 1000 ? `${(totalChars / 1000).toFixed(1)}k` : String(totalChars);

/** 按年月分组，相邻同月合到一枚题签下 */
const groups = new Map<string, { year: number; month: number; label: string; entries: typeof entries }>();
for (const entry of entries) {
  const d = entry.data.date;
  const key = `${d.getFullYear()}-${d.getMonth()}`;
  if (!groups.has(key)) {
    groups.set(key, {
      year: d.getFullYear(),
      month: d.getMonth() + 1,
      label: `${cnNum(d.getFullYear())}年${cnMonth(d.getMonth() + 1)}月`,
      entries: [],
    });
  }
  groups.get(key)!.entries.push(entry);
}
const monthGroups = [...groups.values()].map((g) => ({ ...g, key: `${g.year}-${g.month}` }));
const latestYear = monthGroups[0]?.year ?? 0;

/** 侧栏/返回链接上的短标签：同年只写月份，跨了年份才带上年 */
const tabLabel = (g: { year: number; month: number }) => cnMonthLabel(g.year, g.month, latestYear);

/** 竖排题签按逗号断列（一个人，/ 和一整支 AI 队伍） */
const sloganParts = siteInfo.slogan
  .split('，')
  .map((part, i, arr) => (i < arr.length - 1 ? `${part}，` : part))
  .filter(Boolean);
---

<Base>
  <section class="hero">
    <p class="hero__kicker reveal" style="--d: 0ms" aria-hidden="true">
      <span>Dev Log · Human × Agents</span>
    </p>

    <div class="hero__mast">
      <h1 class="hero__title reveal" style="--d: 70ms">
        <span class="hero__title-ai">AI</span>
        <span>开发日记</span>
        <span class="hero__seal" aria-hidden="true">记</span>
      </h1>
      <p class="hero__slogan reveal" style="--d: 160ms">
        {sloganParts.map((part) => <span>{part}</span>)}
      </p>
    </div>

    <img
      class="hero__art reveal"
      style="--d: 300ms"
      src={withBase('assets/study-corner.png')}
      alt=""
      aria-hidden="true"
      loading="eager"
    />

    <ul class="hero__stats reveal" style="--d: 240ms">
      <li class="hero__stat"><b data-count={entries.length}>{entries.length}</b>篇</li>
      <li class="hero__stat">
        <b data-count={totalChars < 1000 ? totalChars : undefined}>{charText}</b>字
      </li>
      <li class="hero__stat">起于<b>{ym(startDate)}</b></li>
    </ul>
  </section>

  <div class="index">
    {
      monthGroups.length > 1 && (
        <nav class="months" aria-label="按月份浏览日记">
          <p class="months__label" aria-hidden="true">
            卷目
          </p>
          <div class="months__row" role="tablist">
            {monthGroups.map((group, i) => (
              <a
                class={`months__tab${i === 0 ? ' is-active' : ''}`}
                role="tab"
                id={`tab-${group.key}`}
                href={`#m-${group.key}`}
                aria-controls={`m-${group.key}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                <span class="months__name">{tabLabel(group)}</span>
                <span class="months__count">{group.entries.length}</span>
              </a>
            ))}
            <span class="months__indicator" aria-hidden="true" />
          </div>
        </nav>
      )
    }

    {
      monthGroups.length > 0 ? (
        <div class="index__list">
          {monthGroups.map((group, i) => (
            <section
              class="month"
              id={`m-${group.key}`}
              role="tabpanel"
              aria-labelledby={`tab-${group.key}`}
              hidden={i > 0}
            >
              <h2 class="index__month" data-reveal>
                {group.label}
              </h2>
              {group.entries.map((entry, j) => (
                <EntryCard
                  entry={entry}
                  id={`e-${entry.id}`}
                  summary={entry.data.summary || excerpt(entry.body ?? '')}
                  delay={Math.min(140 + j * 60, 700)}
                />
              ))}
            </section>
          ))}
        </div>
      ) : (
        <p class="tl-empty" data-reveal style="--d: 420ms">
          还没有日记。
          <br />
          在 <code>src/content/diary/</code> 里放一个 <code>YYYY-MM-DD-标题.md</code>
          <br />
          然后跑 <code>pnpm new</code> 起草，或直接 <code>pnpm build</code> 上线。
        </p>
      )
    }
  </div>

  <noscript>
    <style>
      .month[hidden] { display: block !important; }
      .months { display: none !important; }
      @media (min-width: 901px) {
        .index { display: block !important; max-width: var(--page-width) !important; }
      }
    </style>
  </noscript>
</Base>
